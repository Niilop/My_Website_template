# Copy to .env for local use. Never commit .env.
# Nothing here is needed for the default static site.

# --- Contact form (only when site.contactForm.enabled is true) ---
# Delivery service: resend | webhook
# CONTACT_DELIVERY=webhook
# CONTACT_WEBHOOK_URL=https://hooks.example.com/your-endpoint

# CONTACT_DELIVERY=resend
# RESEND_API_KEY=
# CONTACT_TO_EMAIL=you@example.com
# CONTACT_FROM_EMAIL="Website <website@your-verified-domain.com>"

# Optional Cloudflare Turnstile spam protection (recommended in production)
# PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
