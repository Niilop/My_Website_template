---
/**
 * The page shell used by every page: metadata, header, main content, and footer.
 */
import '../styles/tokens.css';
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Seo, { type Props as SeoProps } from '../components/Seo.astro';
import { site } from '../site.config';

export type Props = SeoProps;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <Seo {...Astro.props} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    <!-- Analytics or other head scripts: see docs/integrations.md#analytics -->
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: var(--space-2);
    left: var(--space-2);
    z-index: 100;
    padding: var(--space-2) var(--space-4);
    background: var(--color-bg);
    color: var(--color-text);
    border: var(--border);
    border-radius: var(--radius-md);
    transform: translateY(-200%);
  }
  .skip-link:focus {
    transform: none;
  }
  main:focus {
    outline: none;
  }
</style>
