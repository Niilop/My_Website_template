---
import type { GetStaticPaths } from 'astro';
import { getImage, Image } from 'astro:assets';
import { render } from 'astro:content';
import Button from '../../components/Button.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Gallery from '../../components/Gallery.astro';
import Tags from '../../components/Tags.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProjects } from '../../lib/content';

export const getStaticPaths = (async () => {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
const { title, summary, date, cover, tags, links, gallery } = project.data;
const { Content } = await render(project);
const socialImage = cover
  ? await getImage({ src: cover.src, width: 1200, height: 630, format: 'jpg' })
  : undefined;
---

<BaseLayout
  title={title}
  description={summary}
  image={socialImage?.src}
  imageAlt={cover?.alt}
  type="article"
>
  <article class="container project">
    <header class="container--narrow header">
      <p class="muted">
        <a href="/projects/">Projects</a> / <FormattedDate date={date} />
      </p>
      <h1>{title}</h1>
      <p class="lead">{summary}</p>
      <Tags tags={tags} />
    </header>

    {cover && (
      <Image
        src={cover.src}
        alt={cover.alt}
        widths={[640, 1024, 1600]}
        sizes="(min-width: 72rem) 72rem, 100vw"
        loading="eager"
        class="cover"
      />
    )}

    <div class="prose body">
      <Content />
    </div>

    {gallery.length > 0 && (
      <section aria-labelledby="gallery-heading" class="gallery">
        <h2 id="gallery-heading">Gallery</h2>
        <Gallery images={gallery} label={`${title} gallery`} />
      </section>
    )}

    {links.length > 0 && (
      <ul class="links">
        {links.map((link) => (
          <li>
            <Button href={link.href} variant="secondary">
              {link.label}
            </Button>
          </li>
        ))}
      </ul>
    )}
  </article>
</BaseLayout>

<style>
  .project {
    padding-top: var(--space-8);
  }
  .header {
    margin-bottom: var(--space-6);
  }
  .lead {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }
  .cover {
    width: 100%;
    border-radius: var(--radius-lg);
    margin-bottom: var(--space-7);
  }
  .body,
  .header {
    margin-inline: auto;
  }
  .gallery {
    margin-top: var(--space-7);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-7);
    padding: 0;
    list-style: none;
  }
</style>
