---
/**
 * Page metadata: title, description, canonical URL, and social previews.
 * Used by BaseLayout; pages pass values through the layout's props.
 */
import { site } from '../site.config';

export interface Props {
  /** Page title. Omit on the home page to use the site name alone. */
  title?: string;
  description?: string;
  /** Absolute or root-relative image URL for social previews (1200×630 recommended). */
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  image = site.socialImage,
  imageAlt = site.socialImageAlt,
  type = 'website',
  noindex = false,
} = Astro.props;

const fullTitle = title ? `${title} · ${site.name}` : site.name;
const base = Astro.site ?? new URL(site.url);
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = new URL(path, base).href;
const imageUrl = new URL(image, base).href;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={site.ogLocale} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:alt" content={imageAlt} />
<meta name="twitter:card" content="summary_large_image" />
