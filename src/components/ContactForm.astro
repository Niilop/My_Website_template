---
/**
 * Contact form. Rendered only when `site.contactForm.enabled` is true.
 * Works without JavaScript (normal POST + redirect); with JavaScript it submits in place
 * and shows field errors returned by the server.
 */
import { PUBLIC_TURNSTILE_SITE_KEY } from 'astro:env/client';
import { HONEYPOT_FIELD, STARTED_AT_FIELD } from '../lib/contact/spam';
import { limits } from '../lib/contact/validate';
import { site } from '../site.config';
import Button from './Button.astro';
---

<form
  class="contact-form"
  method="post"
  action={site.contactForm.action}
  novalidate
  data-contact-form
>
  <p class="status" role="status" aria-live="polite" data-status></p>

  <div class="field">
    <label for="contact-name">Name</label>
    <input
      id="contact-name"
      name="name"
      type="text"
      autocomplete="name"
      required
      maxlength={limits.name}
      aria-describedby="contact-name-error"
    />
    <p id="contact-name-error" class="error" data-error-for="name"></p>
  </div>

  <div class="field">
    <label for="contact-email">Email</label>
    <input
      id="contact-email"
      name="email"
      type="email"
      autocomplete="email"
      required
      maxlength={limits.email}
      aria-describedby="contact-email-error"
    />
    <p id="contact-email-error" class="error" data-error-for="email"></p>
  </div>

  <div class="field">
    <label for="contact-message">Message</label>
    <textarea
      id="contact-message"
      name="message"
      rows="6"
      required
      maxlength={limits.message}
      aria-describedby="contact-message-error"
    ></textarea>
    <p id="contact-message-error" class="error" data-error-for="message"></p>
  </div>

  <div class="honeypot" aria-hidden="true">
    <label for="contact-website">Leave this field empty</label>
    <input
      id="contact-website"
      name={HONEYPOT_FIELD}
      type="text"
      tabindex="-1"
      autocomplete="off"
    />
  </div>
  <input type="hidden" name={STARTED_AT_FIELD} value="" data-started-at />

  {PUBLIC_TURNSTILE_SITE_KEY && (
    <>
      <div class="cf-turnstile" data-sitekey={PUBLIC_TURNSTILE_SITE_KEY} />
      <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />
    </>
  )}

  <Button type="submit">Send message</Button>
</form>

<script>
  const messages: Record<string, string> = {
    invalid: 'Please check the highlighted fields and try again.',
    unavailable: 'The form is temporarily unavailable. Please email us instead.',
    failed: 'Your message could not be sent. Please try again or email us instead.',
  };

  for (const form of document.querySelectorAll<HTMLFormElement>('[data-contact-form]')) {
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const startedAt = form.querySelector<HTMLInputElement>('[data-started-at]');
    if (startedAt) startedAt.value = String(Date.now());

    const initialError = new URLSearchParams(location.search).get('error');
    if (initialError && messages[initialError]) status.textContent = messages[initialError];

    const showErrors = (errors: Record<string, string>) => {
      for (const el of form.querySelectorAll<HTMLElement>('[data-error-for]')) {
        const field = el.dataset.errorFor!;
        const input = form.elements.namedItem(field) as HTMLInputElement | null;
        el.textContent = errors[field] ?? '';
        input?.setAttribute('aria-invalid', String(Boolean(errors[field])));
      }
      const first = Object.keys(errors)[0];
      if (first) (form.elements.namedItem(first) as HTMLElement | null)?.focus();
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      button.disabled = true;
      status.textContent = 'Sending…';
      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        const result = (await response.json()) as {
          ok: boolean;
          errors?: Record<string, string>;
          error?: string;
        };
        if (result.ok) {
          form.reset();
          showErrors({});
          status.textContent = 'Thank you! Your message has been sent.';
        } else {
          showErrors(result.errors ?? {});
          status.textContent =
            messages[result.errors ? 'invalid' : (result.error ?? 'failed')] ?? messages.failed;
        }
      } catch {
        status.textContent = messages.failed;
      } finally {
        button.disabled = false;
      }
    });
  }
</script>

<style>
  .contact-form {
    display: grid;
    gap: var(--space-4);
    max-width: 36rem;
  }
  .field {
    display: grid;
    gap: var(--space-1);
  }
  label {
    font-weight: var(--weight-bold);
  }
  input,
  textarea {
    width: 100%;
    padding: var(--space-3);
    background: var(--color-bg);
    border: var(--border);
    border-color: var(--color-text-muted);
    border-radius: var(--radius-md);
  }
  [aria-invalid='true'] {
    border-color: var(--color-danger);
  }
  .error {
    margin: 0;
    color: var(--color-danger);
    font-size: var(--text-sm);
  }
  .error:empty,
  .status:empty {
    display: none;
  }
  .status {
    margin: 0;
    padding: var(--space-3);
    border: var(--border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }
  .honeypot {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .contact-form :global(.button) {
    justify-self: start;
  }
</style>
