---
/**
 * Page introduction with a main heading, lead text, optional actions, and optional image.
 * Use once per page — it renders the page's `<h1>`.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

export interface Props {
  title: string;
  lead?: string;
  image?: ImageMetadata;
  /** Required with `image`. Use '' only for purely decorative images. */
  imageAlt?: string;
}

const { title, lead, image, imageAlt = '' } = Astro.props;
---

<div class:list={['hero container', { 'hero--image': image }]}>
  <div class="text">
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    {Astro.slots.has('default') && (
      <div class="actions">
        <slot />
      </div>
    )}
  </div>
  {image && (
    <Image
      src={image}
      alt={imageAlt}
      widths={[480, 800, 1200]}
      sizes="(min-width: 60rem) 50vw, 100vw"
      loading="eager"
      fetchpriority="high"
      class="hero-image"
    />
  )}
</div>

<style>
  .hero {
    display: grid;
    gap: var(--space-6);
    align-items: center;
    padding-block: var(--space-8) 0;
  }
  @media (min-width: 60rem) {
    .hero--image {
      grid-template-columns: 1fr 1fr;
    }
  }
  .text {
    max-width: var(--width-narrow);
  }
  .lead {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }
  .hero-image {
    width: 100%;
    border-radius: var(--radius-lg);
  }
</style>
