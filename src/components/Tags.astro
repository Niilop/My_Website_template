---
export interface Props {
  tags: string[];
  label?: string;
}

const { tags, label = 'Tags' } = Astro.props;
---

{tags.length > 0 && (
  <ul class="tags" aria-label={label}>
    {tags.map((tag) => (
      <li>{tag}</li>
    ))}
  </ul>
)}

<style>
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-3) 0 0;
    padding: 0;
    list-style: none;
  }
  li {
    padding: 0 var(--space-2);
    border: var(--border);
    border-radius: var(--radius-pill);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
</style>
